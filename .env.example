# Copy this file to .env and fill in values for local development.
# .env is auto-loaded on startup (server/index.js, migrate script). Do not commit secrets.

# Storage: PostgreSQL when set, otherwise JSON file (data/db.json)
# Use a pooler URI for serverless/Vercel (port 6543) or direct/session pooler for local/long-running servers.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# POSTGRES_URL=

# Admin bootstrap/sign-in (required in production: NODE_ENV=production)
ADMIN_EMAIL=admin@asfinancial.in
ADMIN_PASSWORD=change-me

# App
# NODE_ENV=development
# PORT=3000
# Public base URL for absolute links (e.g. password reset emails)
# APP_URL=https://as-financial-services-psi.vercel.app

# Password reset email via SMTP (optional; if unset, reset links are logged and returned in non-production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com
