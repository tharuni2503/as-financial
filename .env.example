# Copy this file to .env and fill in values for local development.
# .env is auto-loaded on startup (server/index.js, migrate script). Do not commit secrets.

# Storage: PostgreSQL when set, otherwise JSON file (data/db.json)
# Use a pooler URI for serverless/Vercel (port 6543) or direct/session pooler for local/long-running servers.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# POSTGRES_URL=
# PGSSLMODE=require
# AS_PG_SSL=1

# Admin bootstrap/sign-in (required in production: NODE_ENV=production)
# Set a strong password before production deploy.
ADMIN_EMAIL=asfinancialservicesandsolution@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# App
# NODE_ENV=development
# PORT=3000
# Public base URL for absolute links (e.g. password reset emails)
# APP_URL=https://as-financial.vercel.app

# Password reset email via SMTP (optional; if unset, reset links are logged/returned in non-production only)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com

# Spam/bot protection (optional but recommended)
# Client site key is public; server secret must stay server-only.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Google reviews import (optional, admin-only)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
