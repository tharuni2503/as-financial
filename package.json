{
  "name": "as-financial-site",
  "version": "1.0.0",
  "private": true,
  "description": "AS Financial Services and Solutions - static site plus a small Node backend for published content and website enquiries.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/smoke.test.js tests/security.test.js",
    "test:all": "node --test tests/*.test.js",
    "migrate:pg": "node server/migrate-json-to-pg.js",
    "migrate:pg:dry": "node server/migrate-json-to-pg.js --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1"
  }
}
